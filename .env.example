# =====================================================================
#  MODÈLE de configuration — COPIER ce fichier vers .env puis remplir.
#  Ne mettez JAMAIS de vraie valeur ici. Ce fichier est versionné ;
#  .env ne l'est pas (voir .gitignore).
#
#  RÈGLE ABSOLUE : toutes les clés broker doivent être créées en
#  permission LECTURE SEULE côté broker (voir README, section Sécurité).
# =====================================================================

# ---- Paramètres de gestion du risque (obligatoires) ----
# Capital total pris en compte pour le dimensionnement des positions.
CAPITAL=10000
# Risque max par trade, en fraction du capital (0.01 = 1 %).
RISK_PER_TRADE=0.01
# Devise d'affichage.
BASE_CURRENCY=USD

# ---- Watchlist (obligatoire) ----
# Liste d'instruments séparés par des virgules. Ex actions/crypto/forex.
WATCHLIST=AAPL,MSFT,BTC-USD,ETH-USD
# Classe d'actifs dominante : stocks | crypto | forex (informatif).
ASSET_CLASS=stocks

# ---- News (optionnel : flux RSS par défaut si vide) ----
# Clé NewsAPI (freemium) — laisser vide pour utiliser uniquement le RSS.
NEWSAPI_KEY=

# ---- Connecteurs brokers : LECTURE SEULE UNIQUEMENT ----
# Laisser vide en mode démo. Ne remplir QUE des clés read-only.

# Alpaca (https://alpaca.markets) — créez une clé "read only"
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER=true

# OANDA (https://www.oanda.com) — token API
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice

# Binance (https://www.binance.com) — clé avec SEULEMENT "Enable Reading"
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Kraken (https://www.kraken.com) — clé avec permission "Query" seulement
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Interactive Brokers — via IB Gateway/TWS local (pas de clé dans .env).
# Renseigner l'hôte/port de la passerelle en lecture.
IBKR_HOST=127.0.0.1
IBKR_PORT=4001
IBKR_CLIENT_ID=1
